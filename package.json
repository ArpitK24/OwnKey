{
  "name": "ownkey",
  "version": "1.6.1",
  "description": "Self-hosted AI pull request reviewer: CodeRabbit-style summaries, inline comments with one-click fixes, incremental reviews and @ownkey chat, run in your own GitHub Actions on your own OpenAI, Anthropic, Gemini or Ollama key",
  "main": "dist/index.js",
  "bin": {
    "ownkey": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArpitK24/ownkey.git"
  },
  "bugs": {
    "url": "https://github.com/ArpitK24/ownkey/issues"
  },
  "homepage": "https://github.com/ArpitK24/ownkey#readme",
  "keywords": [
    "code-review",
    "ai-code-review",
    "pull-request",
    "pr-review",
    "github-action",
    "github-actions",
    "self-hosted",
    "coderabbit-alternative",
    "byok",
    "ollama",
    "sarif",
    "pre-commit",
    "llm",
    "cli",
    "developer-tools"
  ],
  "author": "OwnKey Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.36.4",
    "ignore": "^6.0.2",
    "ink": "^5.2.1",
    "inquirer": "^12.2.0",
    "keytar": "^7.9.0",
    "ora": "^8.1.1",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.31",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
